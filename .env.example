# Contact form delivery (src/components/ContactForm.tsx).
# Get an access key from https://web3forms.com — it is bound to the inbox you
# verified when creating it.
#
# NEXT_PUBLIC_ is intentional. Web3Forms' free plan expects the browser to post
# directly to their API, so this value ships in the client bundle; that is their
# documented architecture. The key only permits sending a message to the owner's
# inbox. Proxying it server-side instead would require a paid plan with a
# safelisted server IP.
#
# Copy this file to `.env` and fill the value in there. Never commit `.env`.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Masterclass registration/order persistence (src/lib/mongodb.ts,
# src/app/api/masterclass/registrations/route.ts). Server-only — no
# NEXT_PUBLIC_ prefix, never read by a Client Component.
#
# Connection string for the Atlas (or local) cluster. Never logged, never
# printed, never sent to the browser.
MONGODB_URI=
# Database name only — not part of the connection string, so an environment
# (dev/staging/prod) can point at the same cluster with a different database.
MONGODB_DB=masumdev

# Kill switch for POST /api/masterclass/registrations. Must be the literal
# string "true" to accept submissions; anything else (including unset)
# returns 503 REGISTRATION_NOT_OPEN without touching MongoDB. Stays "false"
# until rate limiting, gateway verification, and privacy review are done —
# see CLAUDE.md.
MASTERCLASS_REGISTRATION_ENABLED=false

# Phase 3B abuse protection (src/lib/masterclass/{turnstile,rate-limit,origin-validation}.ts).
# All server-only except the site key below — never add a real value to any
# of these here, and never fall back to Cloudflare's official always-passes
# test secret in code as a "temporary" default.
#
# Public Turnstile site key — safe to ship in the client bundle by design
# (Cloudflare's own architecture); used only by the Phase 3C widget, not yet
# rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only Turnstile secret, used to call Cloudflare's Siteverify API.
# Never expose this with a NEXT_PUBLIC_ prefix.
TURNSTILE_SECRET_KEY=
# Server-only HMAC key for hashing rate-limit subjects (IP/email) before
# they're stored — the raw value is never persisted, only this keyed digest.
MASTERCLASS_RATE_LIMIT_SECRET=
# Comma-separated exact origins allowed to POST to the registration route.
# Production deployments must not include a localhost entry; the
# origin-validation module also filters one out defensively if NODE_ENV is
# "production", but don't rely on that — set this correctly per environment.
MASTERCLASS_ALLOWED_ORIGINS=http://localhost:3000,https://masumdev.com,https://www.masumdev.com
