# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets.
# The blanket rule would also swallow the template, so it is re-included.
.env
.env.*
!.env.example

# vercel
.vercel

# raw proof-asset screenshots — never committed; only sanitized derivatives
# in public/masterclass/ are published. See CLAUDE.md.
/resources/master_class_assets/

# typescript
*.tsbuildinfo
next-env.d.ts
